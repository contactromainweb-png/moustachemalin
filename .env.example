# Tag Partenaire Amazon (ex. moustachemalin-21). À renseigner aussi dans Netlify.
NEXT_PUBLIC_AMAZON_TAG=

# Prix et images en direct via l API Creators d Amazon (après 10 ventes en 30 jours). Laisser vide.
NEXT_PUBLIC_AMAZON_API_ACTIVE=

# Adresse d envoi du formulaire de lettre d information (outil gratuit à choisir). Vide = formulaire masqué.
NEXT_PUBLIC_NEWSLETTER_URL=

# Clé API Pexels (gratuite, https://www.pexels.com/api/). Secrète : utilisée seulement par le script de
# téléchargement des photos, jamais envoyée au navigateur. À mettre dans .env.local et sur Netlify.
PEXELS_API_KEY=
